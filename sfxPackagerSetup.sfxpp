<scripts>

<script type="initialize">SetProperty(&quot;Download Latest Source Code&quot;, &quot;bool&quot;, &quot;yesno&quot;, 0);</script>

<script type="preinstall">ShowLicenseAcceptanceDlg();DeleteDirectory(BASEPATH);DeleteDirectory(&quot;%APPDATA%/Microsoft/Windows/Start Menu/Programs/sfxPackager&quot;);CreateDirectoryTree(&quot;%APPDATA%/Microsoft/Windows/Start Menu/Programs/sfxPackager&quot;);Echo(&quot;Created Start Menu folder...\n&quot;);</script>

<script type="prefile">function CheckDownloadSource(){	if (GetProperty(&quot;Download Latest Source Code&quot;) == 0)	{		Skip();	}}</script>

<script type="postfile">function CreateStartMenuEntry(lnk_name, description){	CreateShortcut(&quot;%APPDATA%/Microsoft/Windows/Start Menu/Programs/sfxPackager/&quot;+ lnk_name, FILEPATH, &quot;&quot;, BASEPATH, description, 1, FILEPATH, 0);	Echo(&quot;Created Start Menu shortcut...\n&quot;);}</script>

<script type="postinstall"></script>

</scripts>

</sfxpackager>
